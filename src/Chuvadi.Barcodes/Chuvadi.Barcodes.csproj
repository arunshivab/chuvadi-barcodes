<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Chuvadi.Barcodes</AssemblyName>
    <RootNamespace>Chuvadi.Barcodes</RootNamespace>
    <Description>Core types for Chuvadi Barcodes: barcode formats, bit containers (BitBuffer, BitMatrix), Reed-Solomon error correction, ECI character-set tables, luminance images and shared enums. Zero dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Encoders" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Decoders" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Rendering" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Payloads" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Tests" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Encoders.Tests" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Decoders.Tests" />
    <InternalsVisibleTo Include="Chuvadi.Barcodes.Conformance.Tests" />
  </ItemGroup>

</Project>
